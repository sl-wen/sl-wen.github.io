{
  "name": "sl-wen-blog",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "tmx:json": "node ./scripts/convert-tmx-to-json.mjs",
    "tmx:json:default": "node ./scripts/convert-tmx-to-json.mjs src/app/topdown/game/map.tmx public/topdown/game/map.json",
    "dev": "next dev",
    "build": "next build",
    "build:fast": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' SKIP_TYPE_CHECK=1 next build",
    "build:light": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS='--max-old-space-size=4096' SKIP_TYPE_CHECK=1 next build",
    "build:static": "next build && next export",
    "build:ci": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 SKIP_TYPE_CHECK=1 NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fast": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 50",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx --quiet",
    "export": "next export",
    "tsc": "tsc --noEmit",
    "tsc:fast": "tsc --noEmit --skipLibCheck",
    "validate:css": "node --experimental-modules scripts/css-path-validator.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "test:task": "node scripts/test-task-system.js",
    "clean": "rimraf .next out",
    "build:clean": "npm run clean && npm run build",
    "test:assets": "node scripts/test-game-assets.js",
    "test:types": "tsc --noEmit",
    "test": "npm run test:assets && npm run test:types",
    "deploy": "./scripts/deploy.sh",
    "deploy:docker": "DEPLOY_METHOD=docker ./scripts/deploy.sh",
    "deploy:pm2": "DEPLOY_METHOD=pm2 ./scripts/deploy.sh",
    "docker:build": "docker build -t game-app .",
    "docker:run": "docker run -p 3000:3000 game-app",
    "docker:dev": "docker-compose --profile dev up",
    "docker:prod": "docker-compose up -d",
    "postinstall": "npm run sharp:rebuild",
    "sharp:rebuild": "npm rebuild sharp",
    "sharp:install": "npm install --platform=linux --arch=x64 sharp"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.2",
    "@mui/lab": "7.0.0-beta.17",
    "@mui/styles": "6.4.8",
    "@supabase/supabase-js": "2.57.4",
    "buffer": "6.0.3",
    "classnames": "2.5.1",
    "critters": "0.0.25",
    "dompurify": "3.2.6",
    "framer-motion": "12.23.12",
    "gray-matter": "4.0.3",
    "grid-engine": "2.48.1",
    "lodash": "4.17.21",
    "marked": "16.2.1",
    "next": "15.5.3",
    "next-pwa": "5.6.0",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@mui/material": "^7.3.2",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "0.5.16",
    "@types/lodash": "4.17.20",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "autoprefixer": "10.4.21",
    "cross-env": "^10.0.0",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.3",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-xml-parser": "^5.2.5",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "tailwindcss": "4.1.13",
    "tmx-parser": "^1.5.0",
    "tmx2json": "^0.1.1",
    "typescript": "^5.9.2"
  },
  "description": "Modern React blog with Next.js, TypeScript, and Tailwind CSS",
  "keywords": [
    "blog",
    "next.js",
    "react",
    "typescript",
    "tailwind",
    "pwa"
  ],
  "author": "",
  "license": "ISC"
}
