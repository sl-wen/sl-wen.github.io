{
  "name": "sl-wen-blog",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:fast": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "build:static": "next build && next export",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "tsc": "tsc --noEmit",
    "validate:css": "node --experimental-modules scripts/css-path-validator.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "test:task": "node scripts/test-task-system.js",
    "clean": "rimraf .next out",
    "build:clean": "npm run clean && npm run build",
    "test:assets": "node scripts/test-game-assets.js",
    "test:types": "tsc --noEmit",
    "test": "npm run test:assets && npm run test:types",
    "deploy": "./scripts/deploy.sh",
    "deploy:docker": "DEPLOY_METHOD=docker ./scripts/deploy.sh",
    "deploy:pm2": "DEPLOY_METHOD=pm2 ./scripts/deploy.sh",
    "docker:build": "docker build -t game-app .",
    "docker:run": "docker run -p 3000:3000 game-app",
    "docker:dev": "docker-compose --profile dev up",
    "docker:prod": "docker-compose up -d"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "buffer": "^6.0.3",
    "critters": "^0.0.25",
    "dompurify": "^3.2.6",
    "gray-matter": "^4.0.3",
    "grid-engine": "^2.48.0",
    "lodash": "^4.17.21",
    "marked": "^15.0.7",
    "next": "^14.0.4",
    "next-pwa": "^5.6.0",
    "phaser": "^3.88.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.2",
    "classnames": "^2.3.1"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/lodash": "^4.14.202",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.32",
    "prettier": "^3.6.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.2"
  },
  "description": "[![Language](https://img.shields.io/badge/Jekyll-Theme-blue)](https://github.com/sl-wen/slwen)\r [![license](https://img.shields.io/github/license/slwen/slwen)](https://github.com/sl-wen/slwen)\r [![GitHub stars](https://img.shields.io/github/stars/slwen/?style=social)](https://github.com/sl-wen/)",
  "keywords": [
    "blog",
    "next.js",
    "react",
    "typescript",
    "tailwind",
    "pwa"
  ],
  "author": "",
  "license": "ISC"
}
